# External ports exposed on the Synology NAS
ICECAST_PORT=8750
API_PORT=8751

# Icecast stream mount path (stream URL: http://<nas-ip>:8750/hdradio)
ICECAST_MOUNT=/hdradio

# Audio encoding bitrate
MP3_BITRATE=192k

# Default station on first boot (overridden by persisted /data/state.json once tuned)
DEFAULT_FREQ=90.3
DEFAULT_PROGRAM=0

# Optional RTL-SDR hardware settings (leave blank for auto-gain / defaults)
RTL_GAIN=
RTL_PPM=
RTL_DEVICE_INDEX=0

# Optional override for external host IP/hostname returned in stream_url
PUBLIC_HOST=
