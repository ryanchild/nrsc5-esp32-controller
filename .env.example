# Icecast streaming server credentials and mount settings
ICECAST_SOURCE_PASSWORD=hackme
ICECAST_ADMIN_PASSWORD=hackme_admin
ICECAST_RELAY_PASSWORD=hackme_relay
ICECAST_HOSTNAME=localhost
ICECAST_MOUNT=/hdradio
ICECAST_PORT=8750

# Audio encoding settings
MP3_BITRATE=192k

# Default station on first boot (overridden by persisted /data/state.json once tuned)
DEFAULT_FREQ=90.3
DEFAULT_PROGRAM=0

# Optional RTL-SDR settings (leave blank for auto-gain / default)
RTL_GAIN=
RTL_PPM=
RTL_DEVICE_INDEX=0

# Controller HTTP API port
API_PORT=8751

# Optional override for external host IP/hostname returned in stream_url
PUBLIC_HOST=
